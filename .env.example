# Build/public auth pages need no credentials; actual auth requests need configuration.
# Local disposable PostgreSQL only; replace placeholders locally, never commit credentials.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/connecting_work_dev
# Optional direct/unpooled URL for migration CLI; otherwise DATABASE_URL is used.
# DIRECT_DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/connecting_work_dev

# Phase 2 runtime: set these together in ignored .env.local or hosting environment.
# APP_URL=http://localhost:3000
# BETTER_AUTH_URL optional; if set it MUST match APP_URL origin.
# BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters; no example real secret supplied.
# BETTER_AUTH_SECRET=
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=
# Production/staging require explicit HTTPS APP_URL, cloud PostgreSQL and email sender.
# Optional build-time HTTPS production opt-in after domain/TLS review; off by default.
# ENABLE_HSTS=1
# Disposable PostgreSQL integration tests only (never the production endpoint):
# TEST_DATABASE_URL=
# AUTH_TEST_DATABASE=disposable
# Phase 7 business notification delivery is separate from Phase 2 auth mail.
# Avatar/logo storage when needed: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID,
# R2_SECRET_ACCESS_KEY, R2_BUCKET_NAME
# Phase 11 only: NEXT_PUBLIC_POSTHOG_KEY, NEXT_PUBLIC_POSTHOG_HOST,
# SENTRY_DSN, SENTRY_AUTH_TOKEN
# No integration requires these future variables during Foundation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  WORKER
  EMPLOYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                 String           @id
  name               String
  email              String           @unique
  emailVerified      Boolean          @default(false)
  image              String?
  status             AccountStatus    @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  accounts           Account[]
  roles              UserRole[]
  workerProfile      WorkerProfile?
  employerProfile    EmployerProfile?
  companyMemberships CompanyMember[]
  createdCompanies   Company[]        @relation("CompanyCreator")
  createdJobs        Job[]            @relation("JobCreator")
  messages           Message[]
  conversationReads ConversationReadState[]
  notifications     Notification[]
  blocksMade        UserBlock[] @relation("Blocker")
  blocksReceived    UserBlock[] @relation("Blocked")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model UserRole {
  userId    String
  role      Role
  grantedAt DateTime @default(now())
  // Opaque operational change reference for trusted ADMIN grants; never client input.
  grantedBy String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, role])
}

// Shared across instances; not a per-process security counter.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  FREELANCE
  PROJECT
  SHIFT
  INTERNSHIP
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum EmployerType {
  INDIVIDUAL
  SHOP
  STARTUP
  SME
  COMPANY
  AGENCY
}

enum CompanyRole {
  OWNER
  MANAGER
}

enum CompanyVerification {
  UNVERIFIED
  VERIFIED
}

model Skill {
  id        String        @id @default(uuid())
  slug      String        @unique
  name      String
  category  String
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  workers   WorkerSkill[]
  jobs      JobSkill[]

  @@index([active, category])
}

model WorkerProfile {
  id           String               @id @default(uuid())
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  headline     String               @default("")
  city         String?
  bio          String               @default("")
  timezone     String               @default("Asia/Ho_Chi_Minh")
  discoverable Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  skills       WorkerSkill[]
  preferences  WorkerPreference[]
  workModes    WorkerWorkMode[]
  availability WorkerAvailability[]
  applications Application[]
  engagements Engagement[]
  conversations Conversation[]

  @@index([discoverable, city, id])
}

model WorkerSkill {
  workerProfileId String
  skillId         String
  level           SkillLevel
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([workerProfileId, skillId])
  @@index([skillId, workerProfileId])
}

model WorkerPreference {
  workerProfileId String
  type            EmploymentType
  worker          WorkerProfile  @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, type])
  @@index([type, workerProfileId])
}

model WorkerWorkMode {
  workerProfileId String
  mode            WorkMode
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@id([workerProfileId, mode])
}

model WorkerAvailability {
  id              String        @id @default(uuid())
  workerProfileId String
  weekday         Int
  startHour       Int
  endHour         Int
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([workerProfileId, weekday, startHour, endHour])
  @@index([workerProfileId, weekday])
}

model EmployerProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  type        EmployerType @default(INDIVIDUAL)
  description String       @default("")
  city        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  jobs        Job[]
}

model Company {
  id              String              @id @default(uuid())
  slug            String              @unique
  name            String
  description     String              @default("")
  city            String?
  website         String?
  verification    CompanyVerification @default(UNVERIFIED)
  // Creation provenance and retry deduplication only; never an authorization grant.
  createdByUserId String
  createdBy       User                @relation("CompanyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  creationKey     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  members         CompanyMember[]
  jobs            Job[]

  @@unique([createdByUserId, creationKey])
}

model CompanyMember {
  companyId String
  userId    String
  role      CompanyRole
  joinedAt  DateTime    @default(now())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([companyId, userId])
  @@index([userId, companyId])
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  COMPLETED
  CANCELLED
}

enum JobCategory {
  ADMIN_OPERATIONS
  FINANCE_ACCOUNTING
  MARKETING
  CREATIVE
  GENERAL_PART_TIME
}

enum CompensationType {
  HOURLY
  DAILY
  PROJECT
  MONTHLY
}

model Job {
  id                String              @id @default(uuid())
  createdByUserId   String
  createdBy         User                @relation("JobCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  employerProfileId String
  employer          EmployerProfile     @relation(fields: [employerProfileId], references: [id], onDelete: Restrict)
  companyId         String?
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creationKey       String
  title             String              @default("")
  description       String              @default("")
  category          JobCategory?
  status            JobStatus           @default(DRAFT)
  version           Int                 @default(1)
  employmentType    EmploymentType?
  workMode          WorkMode?
  city              String?
  compensationType  CompensationType?
  compensationMin   BigInt?
  compensationMax   BigInt?
  currency          String              @default("VND")
  headcount         Int                 @default(1)
  startDate         DateTime?           @db.Date
  endDate           DateTime?           @db.Date
  timezone          String              @default("Asia/Ho_Chi_Minh")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  publishedAt       DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  skills            JobSkill[]
  schedule          JobScheduleWindow[]
  applications      Application[]
  offers            Offer[]
  engagements       Engagement[]
  conversations     Conversation[]

  @@unique([createdByUserId, creationKey])
  @@index([status, id])
  @@index([employerProfileId, companyId, status])
  @@index([companyId, status])
  @@index([status, city, employmentType, workMode, id])
  @@index([status, publishedAt, id])
  @@index([category, status, id])
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  SHORTLISTED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum EngagementStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Application {
  id              String @id @default(uuid())
  jobId           String
  workerProfileId String
  creationKey     String
  status          ApplicationStatus @default(APPLIED)
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  viewedAt        DateTime?
  shortlistedAt   DateTime?
  offeredAt       DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  withdrawnAt     DateTime?
  cancelledAt     DateTime?
  matchEligibleAtApply Boolean?
  matchScoreAtApply Int?
  matchCoverageAtApply Int?
  matchWeightsVersion String?
  matchAlgorithmVersion String?
  matchedAt DateTime?
  job             Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  worker          WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  offers          Offer[]
  engagement      Engagement?
  conversation    Conversation?

  @@unique([jobId, workerProfileId])
  @@unique([id, jobId])
  @@unique([id, jobId, workerProfileId])
  @@index([workerProfileId, id])
  @@index([jobId, status, id])
}

model Offer {
  id            String @id @default(uuid())
  applicationId String
  jobId         String
  creationKey   String
  revision      Int
  status        OfferStatus @default(PENDING)
  terms         Json
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
  resolvedAt    DateTime?
  application   Application @relation(fields: [applicationId, jobId], references: [id, jobId], onDelete: Restrict)
  job           Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  engagement    Engagement?

  @@unique([applicationId, creationKey])
  @@unique([applicationId, revision])
  @@unique([id, applicationId, jobId])
  @@index([status, expiresAt])
}

model Engagement {
  id                    String @id @default(uuid())
  applicationId         String @unique
  acceptedOfferId       String @unique
  jobId                 String
  workerProfileId       String
  status                EngagementStatus @default(ACCEPTED)
  terms                 Json
  acceptedAt            DateTime @default(now())
  startedAt             DateTime?
  completionRequestedAt DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledBy           String?
  cancellationCategory  String?
  cancellationReason    String?
  updatedAt             DateTime @updatedAt
  application           Application @relation(fields: [applicationId, jobId, workerProfileId], references: [id, jobId, workerProfileId], onDelete: Restrict)
  acceptedOffer         Offer @relation(fields: [acceptedOfferId, applicationId, jobId], references: [id, applicationId, jobId], onDelete: Restrict)
  job                   Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  worker                WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)

  @@index([jobId, status])
  @@unique([applicationId, jobId, workerProfileId])
  @@unique([acceptedOfferId, applicationId, jobId])
  @@index([workerProfileId, status, id])
}

model JobSkill {
  jobId        String
  skillId      String
  required     Boolean    @default(true)
  minimumLevel SkillLevel @default(BEGINNER)
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobId, skillId])
  @@index([skillId, jobId])
}

model JobScheduleWindow {
  id        String @id @default(uuid())
  jobId     String
  weekday   Int
  startHour Int
  endHour   Int
  job       Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, weekday, startHour, endHour])
  @@index([jobId, weekday])
}

enum MessageSide {
  WORKER
  EMPLOYER
}

enum NotificationType {
  NEW_MESSAGE
}

model Conversation {
  id String @id @default(uuid())
  applicationId String @unique
  jobId String
  workerProfileId String
  application Application @relation(fields: [applicationId, jobId, workerProfileId], references: [id, jobId, workerProfileId], onDelete: Restrict)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  worker WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime?
  messages Message[]
  reads ConversationReadState[]
  notifications Notification[]

  @@unique([jobId, workerProfileId])
  @@index([workerProfileId, id])
  @@index([jobId, id])
  @@index([lastMessageAt, id])
  @@unique([applicationId, jobId, workerProfileId])
}

model Message {
  id String @id @default(uuid())
  conversationId String
  senderUserId String
  senderSide MessageSide
  body String
  creationKey String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender User @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  reads ConversationReadState[]
  notifications Notification[]

  @@unique([conversationId, senderUserId, creationKey])
  @@unique([id, conversationId])
  @@index([conversationId, createdAt, id])
  @@index([senderUserId])
}

model ConversationReadState {
  conversationId String
  userId String
  lastReadMessageId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadMessage Message @relation(fields: [lastReadMessageId, conversationId], references: [id, conversationId], onDelete: Restrict)
  updatedAt DateTime @updatedAt

  @@id([conversationId, userId])
  @@index([userId, conversationId])
}

model UserBlock {
  blockerUserId String
  blockedUserId String
  createdAt DateTime @default(now())
  blocker User @relation("Blocker", fields: [blockerUserId], references: [id], onDelete: Restrict)
  blocked User @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId, blockerUserId])
}

model Notification {
  id String @id @default(uuid())
  userId String
  type NotificationType @default(NEW_MESSAGE)
  conversationId String
  lastMessageId String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  lastMessage Message @relation(fields: [lastMessageId, conversationId], references: [id, conversationId], onDelete: Restrict)

  @@index([userId, readAt, createdAt, id])
  @@index([conversationId])
}
